# ─── Database (three roles, three connection strings) ────────────────────────
# All three point at the SAME Postgres database and differ only in role. On
# Neon, `pnpm neon:bootstrap` creates the roles and prints these three strings;
# see README "Neon workflow".

# Tenant traffic. Connects as app_user (subject to RLS; no BYPASSRLS/SUPERUSER,
# owns no tables). Use the POOLED Neon host (ep-…-pooler.…): serverless
# functions open far more connections than Postgres will hold.
#
# The app refuses to serve a single tenant query if this role turns out to
# bypass RLS — pasting a Neon project's default-role string here disables the
# entire security model, so it fails closed instead (src/db/client.internal.ts).
DATABASE_URL=

# Migrations / seeds / (Phase 2) webhooks ONLY. Connects as spectacle_owner —
# a plain role that owns the tables (bypasses RLS as owner; holds NO special
# attributes; see README "no FORCE RLS / no BYPASSRLS"). Use the DIRECT Neon
# host (no -pooler): the migrator takes a session-lifetime advisory lock and
# runs multi-statement DDL, neither of which is safe on a transaction pooler.
DATABASE_URL_OWNER=

# Better Auth infra tables ONLY. Connects as auth_user (zero domain grants).
# Pooled host, like DATABASE_URL.
AUTH_DATABASE_URL=

# ─── Better Auth ─────────────────────────────────────────────────────────────
# AUTH_SECRET is accepted as an alias (the conventional name on Vercel);
# BETTER_AUTH_SECRET wins when both are set.
BETTER_AUTH_SECRET=CHANGE_ME_32_BYTES_MIN

# Absolute origin — it signs OAuth callback URLs and scopes the session cookie.
# Optional on Vercel preview deploys, which fall back to the deployment's own
# hostname. REQUIRED for a production deployment on a custom domain.
BETTER_AUTH_URL=http://localhost:3000

# Optional — Google sign-in button renders only when CLIENT_ID is present.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Storage (S3-compatible; Cloudflare R2) — all optional ───────────────────
# Absent → LocalFsAdapter, which implements the same port.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_DELIVERABLES=
R2_BUCKET_PUBLIC=

# ─── Platform ────────────────────────────────────────────────────────────────
# Basis points of platform fee applied to booking totals (0..5000).
PLATFORM_FEE_BPS=1000
# Discovery is Phase 2 wiring; keep false.
FEATURE_BROWSE=false
