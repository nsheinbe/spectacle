# ─── Database (three roles, three connection strings) ────────────────────────
# Tenant traffic. Connects as app_user (subject to RLS; no BYPASSRLS/SUPERUSER).
DATABASE_URL=postgres://app_user:CHANGE_ME@localhost:5432/spectacle

# Migrations / seeds / (Phase 2) webhooks ONLY. Connects as spectacle_owner —
# a plain role that owns the tables (bypasses RLS as owner; holds NO special
# attributes; see README "no FORCE RLS / no BYPASSRLS").
DATABASE_URL_OWNER=postgres://spectacle_owner:CHANGE_ME@localhost:5432/spectacle

# Better Auth infra tables ONLY. Connects as auth_user (zero domain grants).
AUTH_DATABASE_URL=postgres://auth_user:CHANGE_ME@localhost:5432/spectacle

# ─── Better Auth ─────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=CHANGE_ME_32_BYTES_MIN
BETTER_AUTH_URL=http://localhost:3000

# Optional — Google sign-in button renders only when CLIENT_ID is present.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Storage (Cloudflare R2) — all optional; absent → LocalFsAdapter ─────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_DELIVERABLES=
R2_BUCKET_PUBLIC=

# ─── Platform ────────────────────────────────────────────────────────────────
# Basis points of platform fee applied to booking totals (0..5000).
PLATFORM_FEE_BPS=1000
# Discovery is Phase 2 wiring; keep false.
FEATURE_BROWSE=false
